@model PagedList.IPagedList<_1292886_MVC_CRUD_Project.Models.Sale>
@using PagedList.Mvc

@{
    ViewBag.Title = "Sales";

    var roles = ViewBag.Roles as List<_1292886_MVC_CRUD_Project.Models.TblRole>;
    var users = ViewBag.Users as List<_1292886_MVC_CRUD_Project.Models.TblUser>;
    var paymentMethods = ViewBag.PaymentMethods as List<_1292886_MVC_CRUD_Project.Models.PaymentMethod>;
}

@helper SortIcon(string column)
{
    var currentSort = ViewBag.CurrentSort as string;

    if (currentSort == column)
    {
        <i class="bi bi-arrow-up ms-1 small"></i>
    }
    else if (currentSort == column + "_desc")
    {
        <i class="bi bi-arrow-down ms-1 small"></i>
    }
    else
    {
        <i class="bi bi-arrow-down-up ms-1 text-muted small"></i>
    }
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Sales List</h2>
        <p class="text-muted mb-0">Manage property sales, clients, payments and details</p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <button id="btnCreateSale" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add New Sale
        </button>
    }
</div>

<div id="sales-app">

    @using (Html.BeginForm("", "", FormMethod.Post, new { id = "antiForgeryForm" }))
    {
        @Html.AntiForgeryToken()
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            @using (Html.BeginForm("Index", "Sales", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
              
                <div class="col-lg-4 col-md-6">
                    <label class="form-label small text-muted">Search</label>
                    <input type="text"
                           name="search"
                           value="@ViewBag.CurrentSearch"
                           placeholder="Client, Mobile..."
                           class="form-control form-control-sm shadow-sm" />
                </div>

            
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small text-muted">From Date</label>
                    <input type="date"
                           name="fromDate"
                           value="@ViewBag.FromDate"
                           class="form-control form-control-sm shadow-sm" />
                </div>

              
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small text-muted">Payment</label>
                    <select name="paymentTypeId" class="form-select form-select-sm shadow-sm">
                        <option value="">All</option>
                        @if (ViewBag.PaymentMethods != null)
                        {
                            foreach (var p in ViewBag.PaymentMethods)
                            {
                                <option value="@p.PaymentTypeId">@p.PaymentType</option>
                            }
                        }
                    </select>
                </div>

               
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small text-muted">Status</label>
                    <select name="isPaid" class="form-select form-select-sm shadow-sm">
                        <option value="">All</option>
                        <option value="true" @(ViewBag.IsPaid == true ? "selected" : "")>Paid</option>
                        <option value="false" @(ViewBag.IsPaid == false ? "selected" : "")>Unpaid</option>
                    </select>
                </div>

            
                <div class="col-lg-2 col-md-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100 shadow-sm">
                        <i class="bi bi-search me-1"></i>
                    </button>

                    <a href="@Url.Action("Index","Sales")"
                       class="btn btn-outline-secondary btn-sm w-100">
                        Reset
                    </a>
                </div>
            }

        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-active">
                        <tr>
                            <th class="ps-3">Image</th>

                            <th>
                                @Html.ActionLink("Sale Date", "Index",
                                new { sortOrder = ViewBag.DateSortParm, search = ViewBag.CurrentSearch },
                                new { @class = "text-decoration-none text-dark fw-semibold" })
                                @SortIcon("Date")
                            </th>

                            <th>
                                @Html.ActionLink("Total Price", "Index",
                                new { sortOrder = ViewBag.PriceSortParm, search = ViewBag.CurrentSearch },
                                new { @class = "text-decoration-none text-dark fw-semibold" })
                                @SortIcon("Price")
                            </th>

                            <th>
                                @Html.ActionLink("Client", "Index",
                                new { sortOrder = ViewBag.NameSortParm, search = ViewBag.CurrentSearch },
                                new { @class = "text-decoration-none text-dark fw-semibold" })
                                @SortIcon("Name")
                            </th>

                            <th>
                                @Html.ActionLink("Mobile", "Index",
                                new { sortOrder = ViewBag.MobileSortParm, search = ViewBag.CurrentSearch },
                                new { @class = "text-decoration-none text-dark fw-semibold" })
                                @SortIcon("Mobile")
                            </th>

                            <th>
                                @Html.ActionLink("Payment", "Index",
                                new { sortOrder = ViewBag.PaymentSortParm, search = ViewBag.CurrentSearch },
                                new { @class = "text-decoration-none text-dark fw-semibold" })
                                @SortIcon("Payment")
                            </th>

                            <th>Paid?</th>

                            <th>
                                @Html.ActionLink("Properties", "Index",
                                new { sortOrder = ViewBag.PropertiesSortParm, search = ViewBag.CurrentSearch },
                                new { @class = "text-decoration-none text-dark fw-semibold" })
                                @SortIcon("Properties")
                            </th>

                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="sales-list-body">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var s in Model)
                            {
                                <tr data-sales-id="@s.SalesId">
                                    <td class="ps-3">
                                        <img src="@Url.Content(string.IsNullOrEmpty(s.ClientImage) ? "~/Images/noImg.png" : ("~" + s.ClientImage))"
                                             alt="Client"
                                             class="rounded shadow-sm border"
                                             style="width:70px;height:70px;object-fit:cover;" />
                                    </td>

                                    <td>@s.SaleDate.ToString("yyyy-MM-dd")</td>

                                    <td class="fw-semibold">@s.TotalPrice</td>

                                    <td>@s.ClientName</td>

                                    <td>@s.MobileNo</td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(s.PaymentMethod != null ? s.PaymentMethod.PaymentType : "N/A")
                                        </span>
                                    </td>

                                    <td>
                                        @if (s.IsPaid)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Unpaid</span>
                                        }
                                    </td>

                                    <td>
                                        <ul class="mb-0 ps-3 small">
                                            @foreach (var p in s.Properties)
                                            {
                                                <li><strong>@p.PropertyType</strong> - @p.Location</li>
                                            }
                                        </ul>
                                    </td>

                                    <td class="text-center pe-3">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                                <a class="btn btn-primary btn-sm edit-sale-btn"
                                                   href="@Url.Action("EditPartial", "Sales", new { id = s.SalesId })">
                                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                                </a>

                                                <button type="button"
                                                        class="btn btn-danger btn-sm delete-sale-btn"
                                                        data-sales-id="@s.SalesId"
                                                        data-client-name="@s.ClientName">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No action</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    No sales found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-center">
        @Html.PagedListPager(
     Model,
     page => Url.Action("Index", new
     {
         page,
         search = ViewBag.CurrentSearch,
         sortOrder = ViewBag.CurrentSort,
         fromDate = ViewBag.FromDate,
         paymentTypeId = ViewBag.PaymentTypeId,
         isPaid = ViewBag.IsPaid
     }),
     new PagedListRenderOptions
     {
         Display = PagedListDisplayMode.IfNeeded
     })
    </div>

    @if (Request.IsAuthenticated && User.IsInRole("Admin"))
    {
        <div class="mt-5 mb-3">
            <h4 class="fw-bold">Admin Management</h4>
            <p class="text-muted mb-0">Manage roles and payment methods</p>
        </div>

        <div class="row g-4 mt-1">

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="mb-3">Role Management</h5>



                        <h6 class="mt-4 fw-bold">Assign Role To Existing User</h6>

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success py-2 mt-2">
                                @TempData["Success"]
                            </div>
                        }

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger py-2 mt-2">
                                @TempData["Error"]
                            </div>
                        }

                        @using (Html.BeginForm("AssignUserRole", "Sales", FormMethod.Post, new { @class = "mt-3 mb-4" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="row g-2">
                                <div class="col-md-5">
                                    <select name="userId" class="form-select" required>
                                        <option value="">Select User</option>
                                        @if (users != null && users.Any())
                                        {
                                            foreach (var u in users)
                                            {
                                                <option value="@u.Id">@u.UserName</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="col-md-5">
                                    <select name="roleId" class="form-select" required>
                                        <option value="">Select Role</option>
                                        @if (roles != null && roles.Any())
                                        {
                                            foreach (var r in roles)
                                            {
                                                <option value="@r.Id">@r.RoleName</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-success w-100">
                                        Assign
                                    </button>
                                </div>
                            </div>
                        }

                        @using (Html.BeginForm("AddRole", "Sales", FormMethod.Post, new { @class = "mb-3" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="input-group">
                                <input type="text" name="roleName" class="form-control" placeholder="Enter role name" required />
                                <button type="submit" class="btn btn-primary">Add Role</button>
                            </div>
                        }

                        @if (roles != null && roles.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var role in roles)
                                {
                                    var roleUsers = users != null
                                        ? users.Where(u => u.RoleId == role.Id).ToList()
                                        : new List<_1292886_MVC_CRUD_Project.Models.TblUser>();

                                    <div class="list-group-item px-0 py-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="mb-1 fw-bold">@role.RoleName</h6>
                                                <small class="text-muted">
                                                    Total Users: @roleUsers.Count
                                                </small>
                                            </div>

                                            @using (Html.BeginForm("DeleteRole", "Sales", FormMethod.Post, new { onsubmit = "return confirm('Delete this role?');" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@role.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            }
                                        </div>

                                        @if (roleUsers.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var user in roleUsers)
                                                {
                                                    <span class="role-user-badge">
                                                        @user.UserName
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <small class="text-muted">No users assigned to this role.</small>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No roles found.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="mb-3">Payment Method Management</h5>

                        @using (Html.BeginForm("AddPaymentMethod", "Sales", FormMethod.Post, new { @class = "mb-3" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="input-group">
                                <input type="text" name="paymentType" class="form-control" placeholder="Enter payment method" required />
                                <button type="submit" class="btn btn-success">Add Method</button>
                            </div>
                        }

                        @if (paymentMethods != null && paymentMethods.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var item in paymentMethods)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>@item.PaymentType</span>

                                        @using (Html.BeginForm("DeletePaymentMethod", "Sales", FormMethod.Post, new { onsubmit = "return confirm('Delete this payment method?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.PaymentTypeId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No payment methods found.</p>
                        }
                    </div>
                </div>
            </div>

        </div>
    }

</div>

<div id="modalContainer"></div>

@section scripts{
    <script>
        $(document).ready(function () {

            $("#btnCreateSale").click(function () {
                $.get('@Url.Action("CreatePartial","Sales")', function (data) {
                    $("#modalContainer").html(
                        '<div class="modal fade show custom-sale-modal" style="display:block;" aria-modal="true" role="dialog">' +
                        '<div class="modal-dialog modal-xl modal-dialog-centered">' +
                        '<div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">' + data + '</div>' +
                        '</div></div>' +
                        '<div class="modal-backdrop fade show"></div>'
                    );

                    attachModalEventListeners("Create", null);
                });
            });

            $('#sales-list-body').on('click', '.edit-sale-btn', function (e) {
                e.preventDefault();

                var editUrl = $(this).attr('href');
                var salesId = $(this).closest('tr').data('sales-id');

                $.get(editUrl, function (data) {
                    $("#modalContainer").html(
                        '<div class="modal fade show custom-sale-modal" style="display:block;" aria-modal="true" role="dialog">' +
                        '<div class="modal-dialog modal-xl modal-dialog-centered">' +
                        '<div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">' + data + '</div>' +
                        '</div></div>' +
                        '<div class="modal-backdrop fade show"></div>'
                    );

                    attachModalEventListeners("Edit", salesId);
                });
            });

            $('#sales-list-body').on('click', '.delete-sale-btn', function () {
                var salesId = $(this).data('sales-id');
                var clientName = $(this).data('client-name');
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();

                if (confirm('Delete sale for ' + clientName + '?')) {
                    $.ajax({
                        url: '@Url.Action("DeleteSale","Sales")',
                        type: 'POST',
                        data: {
                            id: salesId,
                            __RequestVerificationToken: token
                        },
                        success: function (response) {
                            if (response.success) {
                                showToast("Sale deleted successfully", "success");

                                setTimeout(function () {
                                    location.reload();
                                }, 800);
                            } else {
                                showToast(response.message || "Error deleting sale", "error");
                            }
                        },
                        error: function () {
                            showToast("Error deleting sale", "error");
                        }
                    });
                }
            });

            function attachModalEventListeners(action, salesId) {

                $(document).off("click", ".modal-backdrop, .modal .btn-secondary, .modal .btn-close-modal")
                    .on("click", ".modal-backdrop, .modal .btn-secondary, .modal .btn-close-modal", function () {
                        $("#modalContainer").empty();
                    });

                $(document).off("submit", "#createSaleForm, #editSaleForm")
                    .on("submit", "#createSaleForm, #editSaleForm", function (e) {

                        e.preventDefault();

                        var form = $(this);
                        var formData = new FormData(this);
                        var url = '';

                        if (form.attr('id') === "createSaleForm" && action === "Create") {
                            url = '@Url.Action("CreateSale","Sales")';
                        }
                        else if (form.attr('id') === "editSaleForm" && action === "Edit") {
                            url = '@Url.Action("EditSale","Sales")';

                            if (salesId) {
                                formData.set("SalesId", salesId);
                            }
                        }

                        if (url) {
                            $.ajax({
                                url: url,
                                type: 'POST',
                                data: formData,
                                contentType: false,
                                processData: false,
                                success: function (response) {

                                    if (typeof response === "object" && response.success) {
                                        $("#modalContainer").empty();
                                        showToast("Sale saved successfully", "success");

                                        setTimeout(function () {
                                            location.reload();
                                        }, 800);
                                    }
                                    else {
                                        $("#modalContainer .modal-content").html(response);
                                        attachModalEventListeners(action, salesId);
                                    }
                                },
                                error: function () {
                                    showToast("Error performing operation", "error");
                                }
                            });
                        }
                    });
            }
        });
    </script>
}