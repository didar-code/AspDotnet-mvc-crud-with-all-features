@model IEnumerable<_1292886_MVC_CRUD_Project.Models.Sale>

@{
    var roles = ViewBag.Roles as List<_1292886_MVC_CRUD_Project.Models.TblRole>;
    var users = ViewBag.Users as List<_1292886_MVC_CRUD_Project.Models.TblUser>;
    var paymentMethods = ViewBag.PaymentMethods as List<_1292886_MVC_CRUD_Project.Models.PaymentMethod>;
    var recentProperties = ViewBag.RecentProperties as List<_1292886_MVC_CRUD_Project.Models.Property>;
    var recentActivitySales = ViewBag.RecentActivitySales as List<_1292886_MVC_CRUD_Project.Models.Sale>;

    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4 mt-4">
    <div class="card border-0 shadow-lg overflow-hidden hero-card bg-gradient">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">

                    <div class="hero-brand-wrap mb-3">
                        <img src="@Url.Content("~/Images/company-logo.png")"
                             alt="Chowdhury Properties Logo"
                             class="hero-logo"
                             onerror="this.onerror=null; this.src='@Url.Content("~/Images/noImg.png")';" />

                        <div class="hero-brand-text">
                            <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 hero-badge">
                                Property Management Dashboard
                            </span>
                        </div>
                    </div>

                    <h1 class="fw-bold mb-3 display-6 hero-title">
                        Manage property sales with clarity and control
                    </h1>

                    <p class="text-muted mb-4 fs-6 hero-description">
                        Monitor sales, property activity, payment insights, and user access
                        from a clean and responsive management dashboard.
                    </p>

                    <div class="d-flex flex-wrap gap-2 hero-action-wrap">
                        <a href="@Url.Action("Index","Sales")" class="btn btn-primary px-4">
                            <i class="bi bi-bar-chart-line me-2"></i> View Sales
                        </a>

                        @if (Request.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <a href="@Url.Action("CreateUser","Account")" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-person-plus me-2"></i> Create User
                            </a>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="rounded-4 border p-3 h-100 text-center bg-light dashboard-feature-box">
                                <i class="bi bi-cash-stack fs-3 text-primary"></i>
                                <div class="fw-semibold mt-2">Sales</div>
                                <small class="text-muted">Track records</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="rounded-4 border p-3 h-100 text-center bg-light dashboard-feature-box">
                                <i class="bi bi-house-check fs-3 text-success"></i>
                                <div class="fw-semibold mt-2">Properties</div>
                                <small class="text-muted">Organized assets</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="rounded-4 border p-3 h-100 text-center bg-light dashboard-feature-box">
                                <i class="bi bi-wallet2 fs-3 text-warning"></i>
                                <div class="fw-semibold mt-2">Payments</div>
                                <small class="text-muted">Secure methods</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="rounded-4 border p-3 h-100 text-center bg-light dashboard-feature-box">
                                <i class="bi bi-shield-lock fs-3 text-danger"></i>
                                <div class="fw-semibold mt-2">Access</div>
                                <small class="text-muted">Role based</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-mini-card border-0 shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Total Sales</div>
                    <h3 class="mb-0 fw-bold">@ViewBag.TotalSales</h3>
                </div>
                <div class="dashboard-icon text-white"
                     style="background: linear-gradient(135deg,#4f46e5,#6366f1);">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-mini-card border-0 shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Paid Sales</div>
                    <h3 class="mb-0 fw-bold">@ViewBag.PaidSales</h3>
                </div>
                <div class="dashboard-icon bg-success-subtle text-success">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-mini-card border-0 shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Unpaid Sales</div>
                    <h3 class="mb-0 fw-bold">@ViewBag.UnpaidSales</h3>
                </div>
                <div class="dashboard-icon bg-danger-subtle text-danger">
                    <i class="bi bi-x-circle"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-mini-card border-0 shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Total Properties</div>
                    <h3 class="mb-0 fw-bold">@ViewBag.TotalProperties</h3>
                </div>
                <div class="dashboard-icon bg-warning-subtle text-warning">
                    <i class="bi bi-building"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-mini-card border-0 shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Total Revenue</div>
                    <h3 class="mb-0 fw-bold">৳ @String.Format("{0:N0}", ViewBag.TotalRevenue ?? 0)</h3>
                </div>
                <div class="dashboard-icon bg-info-subtle text-info">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-mini-card border-0 shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Registered Users</div>
                    <h3 class="mb-0 fw-bold">@ViewBag.TotalUsers</h3>
                </div>
                <div class="dashboard-icon bg-secondary-subtle text-secondary">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-mini-card border-0 shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Roles</div>
                    <h3 class="mb-0 fw-bold">@ViewBag.TotalRoles</h3>
                </div>
                <div class="dashboard-icon bg-dark-subtle text-dark">
                    <i class="bi bi-shield-lock"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-mini-card border-0 shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Payment Methods</div>
                    <h3 class="mb-0 fw-bold">@ViewBag.TotalPaymentMethods</h3>
                </div>
                <div class="dashboard-icon bg-success-subtle text-success">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div>
                        <h4 class="fw-bold mb-1">Recent Sales</h4>
                        <p class="text-muted small mb-0">Latest client transactions and payment status</p>
                    </div>

                    <a href="@Url.Action("Index","Sales")" class="btn btn-sm btn-outline-primary">
                        View All
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle dashboard-table table-hover">
                        <thead class="table-active">
                            <tr>
                                <th>Client</th>
                                <th>Sale Date</th>
                                <th>Payment</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.ClientName</td>
                                        <td>@item.SaleDate.ToString("dd MMM yyyy")</td>
                                        <td>@(item.PaymentMethod != null ? item.PaymentMethod.PaymentType : "N/A")</td>
                                        <td class="fw-semibold">৳ @String.Format("{0:N0}", item.TotalPrice)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No recent sales found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">Quick Actions</h4>

                <div class="d-grid gap-2">
                    <a href="@Url.Action("Index","Sales")" class="btn btn-primary fw-semibold px-4 shadow-sm">
                        <i class="bi bi-list-ul me-2"></i> View Sales List
                    </a>

                    @if (Request.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <a href="@Url.Action("CreateUser","Account")" class="btn btn-outline-secondary">
                            <i class="bi bi-person-plus me-2"></i> Create New User
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">Property Type Summary</h4>

                <ul class="list-group list-group-flush dashboard-summary-list">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span>Home</span>
                        <strong>@ViewBag.HomeCount</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span>Flat</span>
                        <strong>@ViewBag.FlatCount</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span>Apartment</span>
                        <strong>@ViewBag.ApartmentCount</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span>Land</span>
                        <strong>@ViewBag.LandCount</strong>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h4 class="fw-bold mb-1">Recent Properties</h4>
                <p class="text-muted small mb-0">Latest properties with photo preview</p>
            </div>
            <span class="badge bg-light text-dark border">Property Gallery</span>
        </div>

        <div class="row g-4">
            @if (recentProperties != null && recentProperties.Any())
            {
                foreach (var p in recentProperties)
                {
                    <div class="col-xl-4 col-md-6">
                        <div class="card property-card h-100 border-0 shadow-lg overflow-hidden">
                            <img src="@Url.Content("~/Images/Properties/property_" + p.PropertyId + ".jpg")"
                                 onerror="if(this.src.indexOf('.jpg')>-1){this.src='@Url.Content("~/Images/Properties/property_" + p.PropertyId + ".jpeg")';}else if(this.src.indexOf('.jpeg')>-1){this.src='@Url.Content("~/Images/Properties/property_" + p.PropertyId + ".png")';}else{this.src='@Url.Content("~/Images/noImg.png")';}"
                                 class="card-img-top"
                                 style="height:220px; object-fit:cover;"
                                 alt="Property" />

                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2 gap-2 flex-wrap">
                                    <div>
                                        <h5 class="fw-bold mb-1">@p.PropertyType</h5>
                                        <p class="text-muted mb-0">
                                            <i class="bi bi-geo-alt me-1"></i>@p.Location
                                        </p>
                                    </div>
                                    <span class="badge rounded-pill bg-light text-dark border">#@p.PropertyId</span>
                                </div>

                                @if (Request.IsAuthenticated && User.IsInRole("Admin"))
                                {
                                    using (Html.BeginForm("UploadPropertyImage", "Sales", FormMethod.Post, new { enctype = "multipart/form-data", @class = "mt-3" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="propertyId" value="@p.PropertyId" />

                                        <label class="form-label small fw-semibold">Update Property Image</label>
                                        <input type="file"
                                               name="imageFile"
                                               class="form-control form-control-sm mb-2"
                                               accept=".jpg,.jpeg,.png" />
                                        <small class="text-muted d-block mb-2">JPG, JPEG, PNG • Max 2 MB</small>

                                        <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                                            <i class="bi bi-upload me-1"></i> Upload Image
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-muted mb-0">No properties available.</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-5">
                <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 mb-3">About System</span>
                <h4 class="fw-bold mb-3">About Property Management System</h4>
                <p class="text-muted mb-0">
                    This system helps manage property sales, client information, payment methods,
                    property categories, and user roles in one place. It simplifies management tasks
                    with secure access, organized records, and fast overview reporting.
                </p>
            </div>

            <div class="col-lg-7">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 rounded-4 border h-100 bg-light">
                            <h6 class="fw-bold">Sales Management</h6>
                            <p class="mb-0 text-muted small">
                                Track client details, sales records, payment methods, and payment status.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-3 rounded-4 border h-100 bg-light">
                            <h6 class="fw-bold">Admin Control</h6>
                            <p class="mb-0 text-muted small">
                                Manage roles, payment methods, and system access securely.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-3 rounded-4 border h-100 bg-light">
                            <h6 class="fw-bold">Insights & Reports</h6>
                            <p class="mb-0 text-muted small">
                                View totals, property summaries, and payment statistics quickly.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h4 class="fw-bold mb-1">System Features</h4>
                <p class="text-muted small mb-0">Core capabilities of the management system</p>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-3 col-sm-6">
                <div class="p-4 rounded-4 border h-100 text-center bg-light">
                    <i class="bi bi-shield-lock fs-2 text-primary"></i>
                    <h6 class="fw-bold mt-3">Secure Login</h6>
                    <p class="small text-muted mb-0">Role-based authentication and protected access.</p>
                </div>
            </div>

            <div class="col-lg-3 col-sm-6">
                <div class="p-4 rounded-4 border h-100 text-center bg-light">
                    <i class="bi bi-house-check fs-2 text-success"></i>
                    <h6 class="fw-bold mt-3">Property Tracking</h6>
                    <p class="small text-muted mb-0">Organize property type, location, and records.</p>
                </div>
            </div>

            <div class="col-lg-3 col-sm-6">
                <div class="p-4 rounded-4 border h-100 text-center bg-light">
                    <i class="bi bi-wallet2 fs-2 text-warning"></i>
                    <h6 class="fw-bold mt-3">Payment Management</h6>
                    <p class="small text-muted mb-0">Handle multiple payment methods with status tracking.</p>
                </div>
            </div>

            <div class="col-lg-3 col-sm-6">
                <div class="p-4 rounded-4 border h-100 text-center bg-light">
                    <i class="bi bi-bar-chart-line fs-2 text-danger"></i>
                    <h6 class="fw-bold mt-3">Analytics</h6>
                    <p class="small text-muted mb-0">Use summary cards and recent activity insights.</p>
                </div>
            </div>
        </div>
    </div>
</div>